{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "MESA Columns",
  "scopeName": "source.mesa-columns",
  "fileTypes": [],
  "patterns": [
    { "include": "#section-header" },
    { "include": "#directive" },
    { "include": "#column" },
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#number" }
  ],
  "repository": {
    "section-header": {
      "name": "markup.heading.mesa-columns",
      "match": "^\\s*!#{1,3}.*$"
    },
    "directive": {
      "name": "keyword.control.mesa-columns",
      "match": "^\\s*(add_[a-zA-Z0-9_]+|include)\\b"
    },
    "column": {
      "name": "variable.other.member.mesa-columns",
      "match": "^\\s*[a-zA-Z_][a-zA-Z0-9_]*"
    },
    "comment": {
      "name": "comment.line.bang.mesa-columns",
      "match": "!.*$"
    },
    "string": {
      "name": "string.quoted.single.mesa-columns",
      "begin": "'",
      "end": "'"
    },
    "number": {
      "name": "constant.numeric.integer.mesa-columns",
      "match": "\\b-?\\d+\\b"
    }
  }
}
